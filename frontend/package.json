{
  "name": "forge-healthcare-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
    "imports": { "#lib/*": "./src/lib/*" },
  "engines": { "node": "^22.17.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=../.env build/index.js",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
        "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
