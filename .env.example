# Root project environment. Never commit .env or use PUBLIC_ for credentials.
# Copy to .env and supply your own Featherless API key.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3-4B-Instruct-2507
FEATHERLESS_MAX_TOKENS=512
FEATHERLESS_TIMEOUT_SECONDS=60
# Locked remote embedding model used by the existing Python utilities.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
APP_ENV=development
LOG_LEVEL=INFO

# Local development database (matches Docker Compose).
POSTGRES_DB=forgehacks
POSTGRES_USER=forgehacks
POSTGRES_PASSWORD=forgehacks_dev
POSTGRES_PORT=5433
PGHOST=127.0.0.1
# Legacy Python utility setting; SvelteKit uses PGHOST above.
POSTGRES_HOST=localhost
# Optional override for SvelteKit. Python utilities retain their own config.
# DATABASE_URL=postgresql://forgehacks:forgehacks_dev@127.0.0.1:5433/forgehacks

# Set these to match your deployment when using npm --prefix frontend start.
HOST=127.0.0.1
PORT=3000
ORIGIN=http://127.0.0.1:3000
