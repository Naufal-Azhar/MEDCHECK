# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_DB=forgehacks
POSTGRES_USER=forgehacks
POSTGRES_PASSWORD=forgehacks_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://forgehacks:forgehacks_dev@localhost:5433/forgehacks

# LLM provider - fill when Featherless integration begins
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Approved low-cost technical testing model, not yet clinically/safety evaluated.
FEATHERLESS_MODEL=Qwen/Qwen3-4B-Instruct-2507
FEATHERLESS_MAX_TOKENS=512
FEATHERLESS_TIMEOUT_SECONDS=60

# Locked remote embedding model (uses the same Featherless key).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
